FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# IndicTrans2 model variants (distilled = faster, base = more accurate)
INDICTRANS2_EN_INDIC=ai4bharat/indictrans2-en-indic-dist-200M
INDICTRANS2_INDIC_EN=ai4bharat/indictrans2-indic-en-dist-200M

# Ollama settings (for Sanskrit, Tibetan, Pali, Chinese)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
